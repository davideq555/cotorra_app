# Cotorra App - Variables de entorno
# Copiar este archivo a .env y completar con los valores correspondientes

# ===========================================
# API Configuration
# ===========================================
API_BASE_URL=https://apicotorra.deqa.com.ar/api/v1

# Ambientes: development | staging | production
ENVIRONMENT=development

# ===========================================
# Test Credentials (solo para desarrollo)
# ===========================================
# Usuario de prueba para tests de integración
TEST_USER_EMAIL=admin@example.com
TEST_USER_PASSWORD=tu_password_de_test

# ===========================================
# Google Sign-In (Android)
# ===========================================
# Client ID de OAuth 2.0 de Google Cloud Console
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_WEB_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com

# ===========================================
# Notas
# ===========================================
# - NO commitear .env con credenciales reales
# - Copiar .env.example a .env y completar valores
# - En producción, usar variables del servidor/cloud
